				    Source = try Parquet.Document ( File.Contents ( DataFolder & "\fact_trips.parquet" ) ) otherwise Parquet.Document ( File.Contents ( DataFolder & "\fact_trips_sample.parquet" ) ),
				    Typed = Table.TransformColumnTypes ( Source, {{"trip_id", Int64.Type}, {"date_key", Int64.Type}, {"hour_key", Int64.Type}, {"pu_zone_id", Int64.Type}, {"do_zone_id", Int64.Type}, {"payment_type_id", Int64.Type}, {"trip_distance", type number}, {"duration_min", type number}, {"fare_amount", type number}, {"tip_amount", type number}, {"tolls_amount", type number}, {"airport_fee", type number}, {"cbd_congestion_fee", type number}, {"total_amount", type number}, {"distance_band", type text}} )
