/// Pickup hour of day
table dim_time
	lineageTag: d997fd03-facf-592f-b616-9044911db8b9

	column hour_key
		dataType: int64
		formatString: 0
		lineageTag: b4818068-ed68-5f7d-86f9-9a7d51aa1be3
		summarizeBy: none
		sourceColumn: hour_key

		annotation SummarizationSetBy = Automatic

	column hour_label
		dataType: string
		lineageTag: eff22808-f9b4-5559-a548-b142679bb368
		summarizeBy: none
		sourceColumn: hour_label
		sortByColumn: hour_key

		annotation SummarizationSetBy = Automatic

	column day_part
		dataType: string
		lineageTag: cbfa9edd-d7ba-5b03-9a8b-658f96ebe805
		summarizeBy: none
		sourceColumn: day_part

		annotation SummarizationSetBy = Automatic

	partition dim_time = m
		mode: import
		source =
				let
				    Source = Csv.Document ( File.Contents ( DataFolder & "\dim_time.csv" ), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv] ),
				    Promoted = Table.PromoteHeaders ( Source, [PromoteAllScalars = true] ),
				    Typed = Table.TransformColumnTypes ( Promoted, {{"hour_key", Int64.Type}, {"hour_label", type text}, {"day_part", type text}} )
				in
				    Typed
