/// TLC taxi zones
table dim_zone
	lineageTag: d2e929c8-d15b-5635-987f-661ea7c3433f

	column zone_id
		dataType: int64
		formatString: 0
		lineageTag: 8380375e-1a0a-5644-85ac-57a51c46f6f0
		summarizeBy: none
		sourceColumn: zone_id

		annotation SummarizationSetBy = Automatic

	column borough
		dataType: string
		lineageTag: 3d89e4dd-4651-5d60-855a-b6c2c4f14f72
		summarizeBy: none
		sourceColumn: borough

		annotation SummarizationSetBy = Automatic

	column zone_name
		dataType: string
		lineageTag: d4fcdc8f-71d1-50e3-9be6-aebe06c355fd
		summarizeBy: none
		sourceColumn: zone_name

		annotation SummarizationSetBy = Automatic

	column service_zone
		dataType: string
		lineageTag: 1e1361c0-9865-5ba2-9953-131d65df74c4
		summarizeBy: none
		sourceColumn: service_zone

		annotation SummarizationSetBy = Automatic

	column is_airport
		dataType: int64
		formatString: 0
		lineageTag: f980c6b4-58dc-5565-9a6b-e22feb39c862
		summarizeBy: none
		sourceColumn: is_airport

		annotation SummarizationSetBy = Automatic

	partition dim_zone = m
		mode: import
		source =
				let
				    Source = Csv.Document ( File.Contents ( DataFolder & "\dim_zone.csv" ), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv] ),
				    Promoted = Table.PromoteHeaders ( Source, [PromoteAllScalars = true] ),
				    Typed = Table.TransformColumnTypes ( Promoted, {{"zone_id", Int64.Type}, {"borough", type text}, {"zone_name", type text}, {"service_zone", type text}, {"is_airport", Int64.Type}} )
				in
				    Typed
